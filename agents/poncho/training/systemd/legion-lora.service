# Legion mythos LoRA — weekly training (oneshot). Template: adjust WorkingDirectory
# and User, then install to ~/.config/systemd/user/ (user) or /etc/systemd/system/.
[Unit]
Description=Legion mythos LoRA weekly self-improvement run
After=network-online.target

[Service]
Type=oneshot
# Absolute path to the orchestrator on this host:
ExecStart=%h/legion/agents/poncho/training/run_weekly.sh

# ── Resource cap (keep the training run from overheating the host) ──
# run_weekly.sh already caps worker threads to LEGION_LORA_CPU_PERCENT (default
# 60%) of cores via config.env; the directives below add cgroup-level insurance
# and keep the desktop responsive and cool while it runs.
Nice=10
CPUWeight=50
IOSchedulingClass=idle
IOWeight=50
# Optional HARD cpu ceiling (cgroup). systemd can't read nproc, so set this to
# (cores * LEGION_LORA_CPU_PERCENT)% — e.g. 16 cores * 60 = 960%. Uncomment to
# cap total CPU even if a backend ignores the thread env vars:
# CPUQuota=960%
# Optional memory ceiling (match LEGION_LORA_MEM_MAX in config.env if set):
# MemoryMax=8G

# Writable cache for build artifacts / the trained adapter, auto-created RW even
# under ProtectHome=read-only. run_weekly.sh honors $CACHE_DIRECTORY.
CacheDirectory=legion/lora

# Sandbox/hardening (CIS Debian/Ubuntu Benchmark — service confinement).
# This unit only orchestrates a local, CPU-only LoRA run that writes to the
# training reports dir, so confine it tightly. When the real training/packaging
# stages go live, relax as needed: llama.cpp finetune may need JIT/W^X, and
# `ollama create` writes the new model under ~/.ollama (add
# ReadWritePaths=%h/.ollama or loosen ProtectHome).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/legion/agents/poncho/training/reports
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallArchitectures=native
CapabilityBoundingSet=
