# Legion mythos LoRA — tunable budget caps (sourced by run_weekly.sh).
# All optional; defaults keep the weekly job lightweight on CPU.

# Trainable base model (must be an approved, non-blocked model).
# Default is the smallest approved model so a weekly CPU run stays light.
# Set to qwen3:8b only on hosts with more compute.
LEGION_LORA_BASE=qwen3:1.7b

# Max accepted training pairs per run.
LEGION_LORA_MAX_EXAMPLES=256

# LoRA hyperparameters.
LEGION_LORA_RANK=8
LEGION_LORA_STEPS=200

# Hard wall-clock stop (minutes). The job checkpoints and reports 'partial'
# rather than overrunning the budget.
LEGION_LORA_TIME_BUDGET_MIN=30

# ── Resource cap ─────────────────────────────────────────────────────────────
# CPU LoRA finetune will saturate every core and overheat the host if left
# uncapped. Cap it to a percentage of the machine: run_weekly.sh derives the
# training thread count as floor(nproc * percent / 100), so the job uses fewer
# cores and simply takes longer instead of cooking the machine.
#   60  -> ~60% of cores (recommended; what 'toasted the machine' fix uses)
#   100 -> no cap (previous behavior — not recommended)
LEGION_LORA_CPU_PERCENT=60

# Optional hard override of the thread count. When set (non-empty), this wins
# over LEGION_LORA_CPU_PERCENT. Leave empty to auto-derive from the percentage.
LEGION_LORA_THREADS=

# Optional memory ceiling for the run (enforced by the systemd unit's MemoryMax;
# informational for the cron path). Example: 8G. Empty = no explicit cap.
LEGION_LORA_MEM_MAX=

# Local Ollama endpoint (loopback-only per PON-2).
OLLAMA_HOST=http://127.0.0.1:11434
