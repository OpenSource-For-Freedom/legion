# Legion mythos LoRA — tunable budget caps (sourced by run_weekly.sh).
# All optional; defaults keep the weekly job lightweight on CPU.

# Trainable base model (must be an approved, non-blocked model).
# Default is the smallest approved model so a weekly CPU run stays light.
# Set to qwen3:8b only on hosts with more compute.
LEGION_LORA_BASE=qwen3:1.7b

# Max accepted training pairs per run.
LEGION_LORA_MAX_EXAMPLES=256

# LoRA hyperparameters.
LEGION_LORA_RANK=8
LEGION_LORA_STEPS=200

# Hard wall-clock stop (minutes). The job checkpoints and reports 'partial'
# rather than overrunning the budget.
LEGION_LORA_TIME_BUDGET_MIN=30

# Local Ollama endpoint (loopback-only per PON-2).
OLLAMA_HOST=http://127.0.0.1:11434
