#!/usr/bin/env bash
# AppRun — entry point baked into the Legion AppImage (what runs on double-click).
#
# An AppImage executes from a read-only FUSE mount ($APPDIR) that only the
# launching user can see. Legion self-elevates to root via pkexec, and root
# cannot read that mount — so we first copy legion-web out to a normal cache
# path and run *that* copy. Flow mirrors scripts/legion-launch.sh:
#   1. If the dashboard is already up, just open the browser.
#   2. Stage legion-web out of the AppImage mount (root-readable location).
#   3. Launch it; legion-web self-elevates through the polkit admin dialog and
#      serves the dashboard as root for its lifetime.
#   4. --no-open is passed because the elevated (root) process cannot reach this
#      user's browser session — so we open http://localhost:3000 here, as you.
set -u

URL="http://localhost:3000/"
RUN_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/legion"
LOG="$RUN_DIR/legion-web.log"
BIN="$RUN_DIR/legion-web"
mkdir -p "$RUN_DIR"

# $APPDIR is set by the AppImage runtime; fall back to this script's dir when the
# AppDir is run un-bundled (e.g. local testing of an extracted tree).
HERE="${APPDIR:-$(cd "$(dirname "$(readlink -f "$0")")" && pwd)}"
SRC="$HERE/usr/bin/legion-web"

up()      { curl -fsS -o /dev/null --max-time 2 "$URL" 2>/dev/null; }
notify()  { command -v notify-send >/dev/null 2>&1 && notify-send "Legion" "$1" || echo "Legion: $1" >&2; }
open_ui() { command -v xdg-open >/dev/null 2>&1 && xdg-open "$URL" >/dev/null 2>&1 & }

# Already running? Just surface the dashboard.
if up; then
  open_ui
  exit 0
fi

if [ ! -f "$SRC" ]; then
  notify "legion-web missing from the AppImage (looked in $SRC)."
  exit 1
fi

# Prefer a root-owned install when one exists.
#
# Legion needs root to read privileged telemetry, but it must never elevate a
# binary an unprivileged user can rewrite — the copy this launcher stages under
# ~/.cache is exactly that, so legion-web now refuses to elevate from there
# (CVE-class local privilege escalation: overwrite the staged file, wait for the
# next launch, receive root).
#
# A `sudo legion-web install` puts a root-owned copy at a trusted path, and only
# that copy can safely ask for privileges. Running it from here means the
# AppImage itself never elevates anything.
INSTALLED="/usr/local/bin/legion-web"
LAUNCH=""
if [ -x "$INSTALLED" ] && [ ! -w "$INSTALLED" ]; then
  # Only if it matches what this AppImage ships. Preferring the install
  # unconditionally means an AppImage update silently keeps running the older
  # installed build — the same stale-artifact trap that has already cost real
  # debugging time here, just relocated. Current code beats extra privileges:
  # run the bundled copy unprivileged and say what it costs.
  if cmp -s "$SRC" "$INSTALLED"; then
    LAUNCH="$INSTALLED"
  else
    notify "Installed Legion is a different build. Running the bundled one without administrator rights — run: sudo legion-web install"
  fi
fi

# Copy the binary out of the read-only AppImage mount so pkexec (root) can exec
# it; refresh only when the shipped binary differs from the cached copy.
if [ -z "$LAUNCH" ]; then
  # No trusted install: run the bundled copy unprivileged. Legion still works —
  # scanning, correlation, YARA and the analyst are all unprivileged — it just
  # cannot read the system event log or the full process table.
  if [ ! -x "$BIN" ] || ! cmp -s "$SRC" "$BIN"; then
    cp "$SRC" "$BIN" && chmod +x "$BIN" || { notify "Could not stage legion-web in $RUN_DIR."; exit 1; }
  fi
  LAUNCH="$BIN"
  notify "Running without administrator rights. For system event logs, run: sudo legion-web install"
fi

# Launch detached so the server outlives this launcher and its desktop scope.
if command -v setsid >/dev/null 2>&1; then
  setsid "$LAUNCH" --scan-root "$HOME" --no-open >"$LOG" 2>&1 < /dev/null &
else
  nohup  "$LAUNCH" --scan-root "$HOME" --no-open >"$LOG" 2>&1 < /dev/null &
  disown || true
fi

# Wait up to ~40s for the admin prompt to be approved and the port to bind.
for _ in $(seq 1 80); do
  up && break
  sleep 0.5
done

if up; then
  open_ui
else
  notify "Dashboard did not start (admin prompt cancelled?). See $LOG"
  exit 1
fi
