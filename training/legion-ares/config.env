# Ares LoRA training — tunable budget caps (read by ares_train.run as defaults).
LEGION_LORA_TIER=legion-ares:qwen3-1.7b
# Hard wall-clock stop for the QLoRA fine-tune. 120 = 2h, 360 = 6h.
LEGION_LORA_TIME_BUDGET_MIN=360
LEGION_LORA_STEPS=200
LEGION_LORA_RANK=32
LEGION_LORA_MAX_EXAMPLES=600
LEGION_LORA_N_PER=8
# Teacher: hybrid (model, template fallback) | model | template.
LEGION_LORA_TEACHER=hybrid
LEGION_LORA_TEACHER_MODEL=qwen3:14b
# Ollama endpoint (loopback only unless LEGION_ALLOW_REMOTE_OLLAMA=1).
OLLAMA_HOST=http://127.0.0.1:11434
