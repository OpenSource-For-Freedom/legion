# Legion Dev LoRA training — tunable budget caps (read by legion_dev.run as defaults).
LEGION_DEV_TIER=legion-dev:qwen2.5-coder-3b
# Hard wall-clock stop for the QLoRA fine-tune. 120 = 2h, 360 = 6h.
LEGION_DEV_TIME_BUDGET_MIN=360
LEGION_DEV_STEPS=200
LEGION_DEV_RANK=32
LEGION_DEV_MAX_EXAMPLES=600
# Verified solutions to sample per training task (more passing samples = more diversity).
LEGION_DEV_INSTRUCTIONS_PER=3
# Teacher: hybrid (model, verified-reference fallback) | model (teacher only) | reference (seed).
LEGION_DEV_TEACHER=hybrid
# The teacher only runs at dataset-build time — point it at a BIGGER local model
# (qwen2.5-coder:14b / :32b, CPU-spill on 8 GB) to raise the data ceiling for free.
LEGION_DEV_TEACHER_MODEL=qwen2.5-coder:7b
# Ollama endpoint (loopback only unless LEGION_ALLOW_REMOTE_OLLAMA=1).
OLLAMA_HOST=http://127.0.0.1:11434
